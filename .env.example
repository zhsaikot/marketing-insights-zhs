# ===================================================================
# Marketing Insights Local Environment Variables (.env)
# ===================================================================
# Copy this file to .env and fill in your keys as needed.
# Note: Sensitive secrets are strictly kept on the local Express server
# and are NEVER exposed to the frontend browser bundle.
# ===================================================================

# Local Express Server Port (default: 5000)
PORT=5000

# -------------------------------------------------------------------
# Google PageSpeed Insights API Key
# -------------------------------------------------------------------
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# -------------------------------------------------------------------
# 1. Google Analytics 4 (GA4) Service Account
# Paste the entire content of the downloaded service account JSON file.
# -------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# -------------------------------------------------------------------
# 2. Google OAuth 2.0 (for GA4 & Google Search Console Live Auth)
# From Google Cloud Console > Credentials > OAuth 2.0 Client IDs
# -------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# -------------------------------------------------------------------
# 3. Meta Business & Ads API (Graph API)
# From Meta Developers (developers.facebook.com) > App Settings > Basic
# -------------------------------------------------------------------
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret

# -------------------------------------------------------------------
# 4. Token Vault Cloud Persistence (Optional - Upstash Redis)
# If not provided, tokens are safely persisted locally to .data/tokens.json
# -------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
