# ===================================================================
# Marketing Insights Local Environment Configuration (.env)
# ===================================================================
# Copy this file to .env and fill in your keys as needed.
# Note: Sensitive secrets are strictly kept on the local Express server
# and are NEVER exposed to the frontend browser bundle.
# ===================================================================

# Local Express Server Port (default: 5000)
PORT=5000

# -------------------------------------------------------------------
# Google PageSpeed Insights API Key
# Get a free key from: https://developers.google.com/speed/docs/insights/v5/get-started
# -------------------------------------------------------------------
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# -------------------------------------------------------------------
# 1. Google Analytics 4 (GA4) Live Connection
# Method A: Google Cloud Service Account (Recommended for continuous reporting)
# Option 1: Paste full JSON string here
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
# Option 2: Put service-account.json in the project root or provide file path
# GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# GA4 Numeric Property ID (e.g. 384920184)
# GA4_PROPERTY_ID=your_ga4_numeric_property_id

# Method B: Direct Google Access Token (if you already have one)
# GOOGLE_ACCESS_TOKEN=ya29.a0...
# GA4_ACCESS_TOKEN=ya29.a0...
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# 2. Google Search Console (GSC) Live Connection
# Note: The Service Account above can also access Search Console if you add
# the client_email as a User in Google Search Console!
# Website property URL (e.g. https://yourdomain.com or sc-domain:yourdomain.com)
# GSC_SITE_URL=https://yourdomain.com
# GSC_TOKEN=ya29.a0...
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# 3. Google OAuth 2.0 (for 1-click Google Sign-in on Integrations page)
# From Google Cloud Console > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/integrations
# -------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# -------------------------------------------------------------------
# 4. Meta Business & Ads (Facebook/Instagram Ads Live Insights)
# Option A: Direct Meta Access Token & Ad Account ID (Quickest!)
# META_ACCESS_TOKEN=EAAB...
# META_AD_ACCOUNT_ID=act_1234567890

# Option B: Meta Developer App for 1-click OAuth
# From Meta Developers (developers.facebook.com) > App Settings > Basic
# META_APP_ID=your_meta_app_id
# META_APP_SECRET=your_meta_app_secret
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# 5. Token Vault Cloud Persistence (Optional - Upstash Redis)
# If not provided, tokens are safely persisted locally to .data/tokens.json
# -------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
